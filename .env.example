# CognoDB Bolt connection URI, e.g. bolt://localhost:7687
COGNODB_URI=bolt://localhost:7687

# CognoDB username
COGNODB_USER=neo4j

# CognoDB password
COGNODB_PASSWORD=changeme

# Redis connection URL, e.g. redis://localhost:6379
REDIS_URL=redis://localhost:6379

# Max graph nodes an ingest may write before eviction kicks in (engine reads this). Default 200000.
INGEST_NODE_BUDGET=200000

# Groq API key — powers the chat surface (gpt-oss open model). Get one at
# https://console.groq.com. Not needed for MCP (that uses the user's own agent).
GROQ_API_KEY=gsk-your-key-here
# Groq model id for the chat loop (OpenAI-compatible). Defaults to
# openai/gpt-oss-120b when unset.
GROQ_MODEL=openai/gpt-oss-120b

# Comma-separated browser origins allowed to call the separately deployed API.
# CORS_ORIGIN=https://your-project.vercel.app
# Public API URL embedded in the Vercel web build (leave unset for local Vite proxy).
# VITE_API_URL=https://your-api.azurecontainerapps.io
